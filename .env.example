# Credencial da Claude API (https://platform.claude.com/settings/keys).
# Use UMA das duas: ANTHROPIC_API_KEY (sk-ant-api03-...) ou ANTHROPIC_AUTH_TOKEN (token OAuth).
ANTHROPIC_API_KEY=

# Modelo e esforço de raciocínio (low | medium | high)
EMPORIO_MODEL=claude-opus-5-5
EMPORIO_EFFORT=medium

# Data/hora de referência do agente (ISO 8601). Vazio = relógio do sistema.
# Os dados do case vão até mar/2026; fixar uma data ajuda a reproduzir as conversas de exemplo.
EMPORIO_NOW=
