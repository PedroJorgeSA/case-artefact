# Chave da API do Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modelo e esforço de raciocínio (low | medium | high). Vazio = padrão.
EMPORIO_MODEL=openai/gpt-oss-120b
EMPORIO_EFFORT=medium

# Data/hora de referência do agente (ISO 8601). Vazio = relógio do sistema.
# Os dados do case vão até mar/2026; fixar uma data ajuda a reproduzir as conversas de exemplo.
EMPORIO_NOW=2026-03-25T10:00
